<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".QuotaWidgetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuotaWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.QuotaWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.QuotaWidget" />

        <activity
            android:name=".webview.InAppWebViewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.QuotaWidget" />

        <receiver
            android:name=".widget.DeepSeekBalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_deepseek_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deepseek_balance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.DeepSeekBalanceCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_deepseek_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deepseek_balance_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.OpenCodeGoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_opencode_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/opencode_go_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.OpenCodeGoCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_opencode_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/opencode_go_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.OpenCodeGoOverviewWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_opencode_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/opencode_go_widget_overview_info" />
        </receiver>

        <receiver
            android:name=".widget.CodexWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_codex_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/codex_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CodexCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_codex_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/codex_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.CodexOverviewWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_codex_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/codex_widget_overview_info" />
        </receiver>

        <receiver
            android:name=".widget.NewApiBalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_new_api_balance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_api_balance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NewApiBalanceCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_new_api_balance_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_api_balance_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.NewApiUsageWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_new_api_usage_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_api_usage_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.DebugRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kuyermqi.quotawidget.ACTION_DEBUG_REFRESH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
