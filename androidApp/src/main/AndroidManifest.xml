<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".QuotaWidgetApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuotaWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.QuotaWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.QuotaWidget" />

        <receiver
            android:name=".widget.DeepSeekBalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_deepseek_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deepseek_balance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.DeepSeekBalanceCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_deepseek_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deepseek_balance_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.DebugRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kuyermqi.quotawidget.ACTION_DEBUG_REFRESH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
